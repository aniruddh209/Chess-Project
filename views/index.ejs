<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="Play chess online in real-time with friends. A sleek, professional chess experience." />
    <title>Chess Play — Online Chess Game</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#06080d" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <meta name="google-site-verification" content="EuwlH4r5QJxM2uNRCi5DbRTz3t7SvJym6j1qb9EAPF8" />
  </head>
  <body>
    <script>
      (function() {
        const savedMode = localStorage.getItem("chess-app-theme") || "dark";
        const savedVisual = localStorage.getItem("chess-visual-theme") || "obsidian";
        const body = document.body || document.documentElement;
        
        if (savedMode === "light") {
          body.classList.add("light-theme");
        } else if (savedMode === "system") {
          const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (!isDark) {
            body.classList.add("light-theme");
          }
        }
        
        if (savedVisual && savedVisual !== "obsidian") {
          body.classList.add("theme-" + savedVisual);
        }
      })();
    </script>
    <!-- ============================================================
         PREMIUM SPLASH SCREEN (App Launch)
         ============================================================ -->
    <div id="app-splash-screen" class="splash-screen">
      <div class="splash-content">
        <div class="splash-logo-container">
          <img src="/icon-512.png" alt="Chess Play" class="splash-logo" />
        </div>
        <h1 class="splash-title">ChessPlay</h1>
        <p class="splash-subtitle">Where strategy meets elegance</p>
      </div>
      <div class="splash-footer">
        <p class="splash-footer-dev">Developed by</p>
        <p class="splash-footer-name">Aniruddh Parmar</p>
      </div>
    </div>

    <!-- Ambient Background Glow -->
    <div class="ambient-glow ambient-glow-1"></div>
    <div class="ambient-glow ambient-glow-2"></div>
    <div class="ambient-glow ambient-glow-3"></div>
    <!-- ============================================================
         SCREEN 1: AUTH (Login / Signup)
         ============================================================ -->
    <div id="auth-screen" class="screen active-screen">
      <div class="auth-container">

        <!-- Left: Hero / Branding -->
        <div class="auth-hero">
          <div class="auth-hero-pieces">
            <span class="floating-piece fp-1">♔</span>
            <span class="floating-piece fp-2">♛</span>
            <span class="floating-piece fp-3">♜</span>
            <span class="floating-piece fp-4">♞</span>
            <span class="floating-piece fp-5">♝</span>
            <span class="floating-piece fp-6">♟</span>
          </div>
          <div class="auth-hero-content">
            <h1 class="auth-title">ChessPlay</h1>
            <p class="auth-tagline">Where strategy meets elegance</p>
            <div class="auth-features">
              <div class="auth-feat"><span class="auth-feat-icon">⚔️</span><span>Play with Friends</span></div>
              <div class="auth-feat"><span class="auth-feat-icon">🤖</span><span>Challenge AI</span></div>
              <div class="auth-feat"><span class="auth-feat-icon">👥</span><span>Offline PvP</span></div>
              <div class="auth-feat"><span class="auth-feat-icon">📊</span><span>Track Your Stats</span></div>
              <div class="auth-feat"><span class="auth-feat-icon">🎨</span><span>Custom Board Themes</span></div>
            </div>
          </div>
        </div>

        <!-- Right: Auth Form -->
        <div class="auth-form-wrapper">
          <div class="auth-logo">
            <span class="logo-icon-large">♔</span>
          </div>

          <!-- Login Form -->
          <div id="login-form" class="auth-form glass-panel">
            <h2 class="auth-form-title">Welcome Back</h2>
            <div class="form-group">
              <label for="login-username">Username</label>
              <input type="text" id="login-username" placeholder="Username" autocomplete="username" maxlength="20" />
            </div>
            <div class="form-group">
              <label for="login-password">Password</label>
              <input type="password" id="login-password" placeholder="Password" autocomplete="current-password" />
            </div>
            <div id="login-error" class="auth-error" style="display:none;"></div>
            <button id="btn-login" class="btn btn-primary btn-full">Sign In</button>
            <p class="auth-switch">
              New here?
              <a href="#" id="show-signup">Create Account</a>
            </p>
          </div>

          <!-- Signup Form -->
          <div id="signup-form" class="auth-form glass-panel" style="display:none;">
            <h2 class="auth-form-title">Create Account</h2>
            <div class="form-group">
              <label for="signup-username">Username</label>
              <input type="text" id="signup-username" placeholder="Username" autocomplete="username" maxlength="20" />
            </div>
            <div class="form-group">
              <label for="signup-password">Password</label>
              <input type="password" id="signup-password" placeholder="Password" autocomplete="new-password" />
            </div>
            <div class="form-group">
              <label for="signup-confirm">Confirm Password</label>
              <input type="password" id="signup-confirm" placeholder="Confirm password" autocomplete="new-password" />
            </div>
            <div id="signup-error" class="auth-error" style="display:none;"></div>
            <button id="btn-signup" class="btn btn-primary btn-full">Create Account</button>
            <p class="auth-switch">
              Have an account?
              <a href="#" id="show-login">Sign In</a>
            </p>
          </div>

          <!-- Offline PvP — Play without login -->
          <div class="auth-offline-divider">
            <span class="auth-divider-line"></span>
            <span class="auth-divider-text">or play without account</span>
            <span class="auth-divider-line"></span>
          </div>

          <div class="auth-offline-section glass-panel">
            <div class="auth-offline-header">
              <span class="auth-offline-icon">👥</span>
              <div>
                <h3 class="auth-offline-title">Offline PvP</h3>
                <p class="auth-offline-desc">Play with a friend on the same device — no internet needed!</p>
              </div>
            </div>
            <div class="time-picker" style="margin-top:10px; border-top: none; padding-top: 4px;">
              <span class="time-picker-label">⏱ Time Control</span>
              <div class="time-options">
                <label class="time-option"><input type="radio" name="auth-offline-time" value="300" /><span class="time-badge">5 min</span></label>
                <label class="time-option"><input type="radio" name="auth-offline-time" value="600" checked /><span class="time-badge">10 min</span></label>
                <label class="time-option"><input type="radio" name="auth-offline-time" value="900" /><span class="time-badge">15 min</span></label>
                <label class="time-option"><input type="radio" name="auth-offline-time" value="0" /><span class="time-badge">∞</span></label>
              </div>
            </div>
            <button id="btn-auth-offline-pvp" class="btn btn-primary btn-full" style="margin-top: 12px;">⚔ Play Offline PvP</button>
          </div>

          <p class="auth-footer">Developed by Aniruddh Parmar</p>
        </div>

      </div>
    </div>

    <!-- ============================================================
         SCREEN 2: LOBBY (Create or Join Room)
         ============================================================ -->
    <div id="lobby-screen" class="screen">
      <div class="lobby-container">

        <!-- Lobby Header -->
        <div class="lobby-header">
          <div class="logo">
            <span class="logo-icon">♔</span>
            <span class="logo-text">ChessPlay</span>
          </div>
          <div class="lobby-user-info">
            <span class="lobby-greeting">Hello, <strong id="lobby-username"></strong></span>
            <button id="btn-profile" class="btn btn-secondary btn-small">👤 Profile</button>
            <button id="btn-settings" class="btn btn-secondary btn-small">⚙️ Settings</button>
            <button id="btn-logout" class="btn btn-secondary btn-small">Logout</button>
          </div>
        </div>

        <!-- Hero Section -->
        <div class="lobby-hero">
          <div class="hero-content">
            <h1 class="hero-title">Your Move Awaits</h1>
            <p class="hero-subtitle">Challenge friends or test your skills against AI. Pick your style and start playing.</p>
          </div>
          <div class="hero-features">
            <div class="hero-feat"><span class="feat-icon">⚔️</span><span>Multiplayer</span></div>
            <div class="hero-feat"><span class="feat-icon">🤖</span><span>AI Opponent</span></div>
            <div class="hero-feat"><span class="feat-icon">👥</span><span>Offline PvP</span></div>
            <div class="hero-feat"><span class="feat-icon">📊</span><span>Track Stats</span></div>
            <div class="hero-feat"><span class="feat-icon">🎨</span><span>Board Themes</span></div>
          </div>
        </div>

        <!-- Spacer after removing settings from lobby -->
        <div style="margin-top: 10px;"></div>

        <!-- Game Mode Cards -->
        <h2 class="section-title">🎮 Start a Game</h2>
        <div class="lobby-cards">
          <!-- Create Room Card -->
          <div class="lobby-card glass-panel" id="card-create">
            <div class="lobby-card-icon">♔</div>
            <h2 class="lobby-card-title">Create Room</h2>
            <p class="lobby-card-desc">Start a new game and invite a friend</p>
            <div class="color-picker">
              <label class="color-option">
                <input type="radio" name="create-color" value="white" checked />
                <span class="color-swatch color-white">♔</span>
                <span>White</span>
              </label>
              <label class="color-option">
                <input type="radio" name="create-color" value="black" />
                <span class="color-swatch color-black">♚</span>
                <span>Black</span>
              </label>
              <label class="color-option">
                <input type="radio" name="create-color" value="random" />
                <span class="color-swatch color-random">🎲</span>
                <span>Random</span>
              </label>
            </div>
            <div class="time-picker">
              <span class="time-picker-label">⏱ Time Control</span>
              <div class="time-options">
                <label class="time-option"><input type="radio" name="create-time" value="300" /><span class="time-badge">5 min</span></label>
                <label class="time-option"><input type="radio" name="create-time" value="600" checked /><span class="time-badge">10 min</span></label>
                <label class="time-option"><input type="radio" name="create-time" value="900" /><span class="time-badge">15 min</span></label>
                <label class="time-option"><input type="radio" name="create-time" value="1800" /><span class="time-badge">30 min</span></label>
                <label class="time-option"><input type="radio" name="create-time" value="0" /><span class="time-badge">∞</span></label>
              </div>
            </div>
            <button id="btn-create-room" class="btn btn-primary btn-full">Create Room</button>
          </div>

          <!-- Join Room Card -->
          <div class="lobby-card glass-panel" id="card-join">
            <div class="lobby-card-icon">♚</div>
            <h2 class="lobby-card-title">Join Room</h2>
            <p class="lobby-card-desc">Enter your friend's room code to join</p>
            <div class="form-group">
              <input type="text" id="join-room-code" placeholder="Enter 6-letter code" maxlength="6" style="text-transform: uppercase; text-align: center; font-size: 20px; letter-spacing: 4px;" />
            </div>
            <div id="join-error" class="auth-error" style="display:none;"></div>
            <button id="btn-join-room" class="btn btn-primary btn-full">Join Room</button>
          </div>

          <!-- Play vs AI Card -->
          <div class="lobby-card glass-panel" id="card-ai">
            <div class="lobby-card-icon">🤖</div>
            <h2 class="lobby-card-title">Play vs AI</h2>
            <p class="lobby-card-desc">Challenge the computer at your level</p>
            <div class="ai-difficulty">
              <label class="diff-option">
                <input type="radio" name="ai-diff" value="easy" />
                <span class="diff-badge diff-easy">Easy</span>
              </label>
              <label class="diff-option">
                <input type="radio" name="ai-diff" value="medium" checked />
                <span class="diff-badge diff-medium">Medium</span>
              </label>
              <label class="diff-option">
                <input type="radio" name="ai-diff" value="hard" />
                <span class="diff-badge diff-hard">Hard</span>
              </label>
            </div>
            <div class="color-picker">
              <label class="color-option">
                <input type="radio" name="ai-color" value="white" checked />
                <span class="color-swatch color-white">♔</span>
                <span>White</span>
              </label>
              <label class="color-option">
                <input type="radio" name="ai-color" value="black" />
                <span class="color-swatch color-black">♚</span>
                <span>Black</span>
              </label>
              <label class="color-option">
                <input type="radio" name="ai-color" value="random" />
                <span class="color-swatch color-random">🎲</span>
                <span>Random</span>
              </label>
            </div>
            <div class="time-picker">
              <span class="time-picker-label">⏱ Time Control</span>
              <div class="time-options">
                <label class="time-option"><input type="radio" name="ai-time" value="300" /><span class="time-badge">5 min</span></label>
                <label class="time-option"><input type="radio" name="ai-time" value="600" checked /><span class="time-badge">10 min</span></label>
                <label class="time-option"><input type="radio" name="ai-time" value="900" /><span class="time-badge">15 min</span></label>
                <label class="time-option"><input type="radio" name="ai-time" value="0" /><span class="time-badge">∞</span></label>
              </div>
            </div>
            <button id="btn-play-ai" class="btn btn-primary btn-full">Play AI</button>
          </div>

          <!-- Offline PvP Card -->
          <div class="lobby-card glass-panel" id="card-offline-pvp">
            <div class="lobby-card-icon">👥</div>
            <h2 class="lobby-card-title">Offline PvP</h2>
            <p class="lobby-card-desc">Play with a friend on the same device — no internet needed!</p>
            <div class="time-picker">
              <span class="time-picker-label">⏱ Time Control</span>
              <div class="time-options">
                <label class="time-option"><input type="radio" name="offline-time" value="300" /><span class="time-badge">5 min</span></label>
                <label class="time-option"><input type="radio" name="offline-time" value="600" checked /><span class="time-badge">10 min</span></label>
                <label class="time-option"><input type="radio" name="offline-time" value="900" /><span class="time-badge">15 min</span></label>
                <label class="time-option"><input type="radio" name="offline-time" value="1800" /><span class="time-badge">30 min</span></label>
                <label class="time-option"><input type="radio" name="offline-time" value="0" /><span class="time-badge">∞</span></label>
              </div>
            </div>
            <button id="btn-offline-pvp" class="btn btn-primary btn-full">⚔ Start Offline Game</button>
          </div>
        </div>

        <!-- Footer -->
        <div class="lobby-footer">
          <p>♟ ChessPlay — Developed by Aniruddh Parmar</p>
        </div>
      </div>

      <!-- Profile Modal -->
      <div id="profile-modal" class="modal-overlay" style="display:none;">
        <div class="modal glass-panel profile-modal-content" style="max-height: 90vh; overflow-y: auto; max-width: 680px; width: 92%;">
          <button id="btn-close-profile" class="btn-close-chat" style="position:absolute;top:16px;right:16px;z-index:10;">✕</button>
          
          <div class="profile-header">
            <div class="profile-avatar">👤</div>
            <h2 class="profile-name" id="profile-name">—</h2>
            <p class="profile-since" id="profile-since">Member since —</p>
          </div>

          <!-- Streak Card -->
          <div class="streak-card-container glass-panel" style="margin-top: 16px; padding: 16px; border-radius: 12px; background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.15); display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 16px; font-weight: 700; color: #ff9900; display: flex; align-items: center; gap: 6px;">
                🔥 <span id="streak-current">0</span> Day Streak
              </span>
              <span style="font-size: 12px; color: var(--text-muted);">Best Streak: <strong id="streak-best" style="color: var(--text-primary);">0</strong></span>
            </div>
            
            <div class="streak-days" id="streak-days-row" style="display: flex; justify-content: space-between; background: rgba(0,0,0,0.15); padding: 8px 12px; border-radius: 8px;">
              <!-- Will be filled by JS: Mon, Tue, etc. -->
            </div>
          </div>

          <div class="profile-stats" style="margin-top: 20px;">
            <div class="stat-card">
              <span class="stat-value" id="stat-games">0</span>
              <span class="stat-label">Played</span>
            </div>
            <div class="stat-card stat-win">
              <span class="stat-value" id="stat-wins">0</span>
              <span class="stat-label">Wins</span>
            </div>
            <div class="stat-card stat-loss">
              <span class="stat-value" id="stat-losses">0</span>
              <span class="stat-label">Losses</span>
            </div>
            <div class="stat-card stat-draw">
              <span class="stat-value" id="stat-draws">0</span>
              <span class="stat-label">Draws</span>
            </div>
          </div>

          <div class="profile-winrate" style="margin-top: 16px;">
            <span class="winrate-label">Win Rate</span>
            <div class="winrate-bar">
              <div class="winrate-fill" id="winrate-fill" style="width:0%;">0%</div>
            </div>
          </div>

          <!-- Color Performance -->
          <h3 class="panel-title" style="margin-top:24px; font-size:14px; text-transform:uppercase; letter-spacing:1px; color:var(--accent);">⚪ vs ⚫ Color Performance</h3>
          <div class="color-perf-container" style="display: flex; gap: 16px; margin-top: 8px;">
            <div class="glass-panel" style="flex: 1; padding: 12px; border-radius: 8px; text-align: center;">
              <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 4px;">As White</p>
              <div style="font-size: 16px; font-weight: 700; color: var(--text-primary);" id="white-record">0W - 0L - 0D</div>
              <p style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Games: <span id="white-total">0</span></p>
            </div>
            <div class="glass-panel" style="flex: 1; padding: 12px; border-radius: 8px; text-align: center;">
              <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 4px;">As Black</p>
              <div style="font-size: 16px; font-weight: 700; color: var(--text-primary);" id="black-record">0W - 0L - 0D</div>
              <p style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Games: <span id="black-total">0</span></p>
            </div>
          </div>

          <!-- Time Control & Play Metrics -->
          <h3 class="panel-title" style="margin-top:24px; font-size:14px; text-transform:uppercase; letter-spacing:1px; color:var(--accent);">⏱ Time Control & Metrics</h3>
          <div class="metrics-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 8px;">
            <div class="glass-panel" style="padding: 12px; border-radius: 8px; text-align: center;">
              <div style="font-size: 11px; color: var(--text-muted);">Avg. Move Count</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-top: 4px;" id="metric-avg-moves">0</div>
            </div>
            <div class="glass-panel" style="padding: 12px; border-radius: 8px; text-align: center;">
              <div style="font-size: 11px; color: var(--text-muted);">Avg. Duration</div>
              <div style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-top: 4px;" id="metric-avg-duration">0m 0s</div>
            </div>
          </div>

          <!-- Time control breakdown list -->
          <div class="tc-breakdown glass-panel" style="margin-top: 12px; padding: 12px; border-radius: 8px; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 4px;">
              <span>Time Control</span>
              <span>Record (W - L - D)</span>
              <span>Total Games</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12px;">
              <span>Bullet (&lt;3 min)</span>
              <span id="tc-bullet-record">0 - 0 - 0</span>
              <span id="tc-bullet-total">0</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12px;">
              <span>Blitz (3 - 10 min)</span>
              <span id="tc-blitz-record">0 - 0 - 0</span>
              <span id="tc-blitz-total">0</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12px;">
              <span>Rapid (&gt;10 min)</span>
              <span id="tc-rapid-record">0 - 0 - 0</span>
              <span id="tc-rapid-total">0</span>
            </div>
          </div>

          <h3 class="panel-title" style="margin-top:24px;">Recent Games</h3>
          <div class="recent-games" id="recent-games" style="margin-top: 8px;">
            <p style="color:var(--text-muted);font-size:13px;text-align:center;">No games yet</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         SETTINGS MODAL — Personalize ChessPlay
         ============================================================ -->
    <div id="settings-modal" class="modal-overlay" style="display:none; z-index: 10008;">
      <div class="modal glass-panel settings-modal-content" style="max-height: 90vh; overflow-y: auto; max-width: 800px; width: 92%; padding: 28px; text-align: left;">
        <button id="btn-close-settings" class="btn-close-chat" style="position:absolute;top:16px;right:16px;z-index:10;">✕</button>
        
        <div class="settings-header" style="margin-bottom: 24px;">
          <h2 style="margin: 0; font-size: 24px; font-family: 'Playfair Display', serif; color: var(--accent); display: flex; align-items: center; gap: 8px;">
            ⚙️ Settings
          </h2>
          <p style="margin: 4px 0 0; font-size: 13px; color: var(--text-secondary);">Personalize your ChessPlay experience</p>
        </div>

        <div class="settings-layout">
          <!-- Categories Sidebar (Tabs) -->
          <div class="settings-sidebar">
            <button class="settings-tab-btn active" data-tab="appearance">🎨 Appearance</button>
            <button class="settings-tab-btn" data-tab="chessboard">🏁 Chessboard</button>
            <button class="settings-tab-btn" data-tab="pieces">👑 Pieces</button>
            <button class="settings-tab-btn" data-tab="gameplay">⚔️ Gameplay</button>
            <button class="settings-tab-btn" data-tab="sound">🔊 Sound</button>
            <button class="settings-tab-btn" data-tab="accessibility">♿ Accessibility</button>
          </div>

          <!-- Content Area -->
          <div class="settings-content" id="settings-content-panel">
             <!-- Dynamically filled by JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         SCREEN 3: WAITING ROOM (Show code, wait for opponent)
         ============================================================ -->
    <div id="waiting-screen" class="screen">
      <div class="waiting-container">
        <div class="glass-panel waiting-panel">
          <div class="waiting-icon">⏳</div>
          <h2 class="waiting-title">Waiting for Opponent</h2>
          <p class="waiting-desc">Share this room code with your friend:</p>
          <div class="room-code-display" id="room-code-display">------</div>
          <button id="btn-copy-code" class="btn btn-secondary btn-full">📋 Copy Code</button>
          <div id="copy-feedback" class="copy-feedback" style="display:none;">Copied!</div>
          <div class="waiting-dots">
            <span></span><span></span><span></span>
          </div>
          <button id="btn-back-lobby" class="btn btn-secondary btn-full" style="margin-top: 12px;">← Back to Lobby</button>
        </div>
      </div>
    </div>

    <!-- ============================================================
         SCREEN 4: GAME (The chess board)
         ============================================================ -->
    <div id="game-screen" class="screen">
      <!-- Header / Navigation -->
      <header id="site-header">
        <div class="header-inner">
          <div class="logo">
            <span class="logo-icon">♔</span>
            <span class="logo-text">ChessPlay</span>
          </div>
          <nav class="header-nav" style="display: flex; align-items: center; gap: 8px;">
            <span class="room-code-badge" id="game-room-code">Room: ------</span>
            <span class="nav-badge" id="connection-status">
              <span class="status-dot"></span>
              <span class="connection-text">Connecting…</span>
            </span>
            <button id="btn-game-settings" class="btn btn-secondary btn-small" style="font-size: 14px; padding: 6px 10px; border-radius: 8px;" title="Settings">⚙️</button>
          </nav>
        </div>
      </header>

      <!-- Main Game Area -->
      <main id="game-area">
        <div class="game-container">

          <!-- Left Sidebar — Moves + Captured -->
          <aside class="sidebar sidebar-left">
            <div class="panel glass-panel moves-panel">
              <h3 class="panel-title">📋 Moves</h3>
              <div class="move-list" id="move-list">
                <div class="move-placeholder">No moves yet</div>
              </div>
            </div>
            <div class="panel glass-panel">
              <h3 class="panel-title">Captured</h3>
              <div class="captured-section">
                <div class="captured-label">By White</div>
                <div class="captured-pieces" id="captured-by-white"></div>
              </div>
              <div class="captured-section">
                <div class="captured-label">By Black</div>
                <div class="captured-pieces" id="captured-by-black"></div>
              </div>
            </div>
          </aside>

          <!-- Center — Board + Players -->
          <section class="board-section">
            <div class="player-bar player-bar-top" id="player-top">
              <div class="player-avatar">♚</div>
              <div class="player-info">
                <span class="player-name">Black</span>
                <span class="player-status">Waiting…</span>
              </div>
            </div>
            <div class="game-clock" id="game-clock" style="display:none;">
              <span class="clock-icon">⏱</span>
              <span class="clock-time" id="game-timer">--:--</span>
            </div>
            <div class="game-status-banner" id="game-status" style="display:none;">
              <span class="status-text" id="status-text"></span>
            </div>
            <div class="board-wrapper">
              <div class="board-coords board-coords-files">
                <span>a</span><span>b</span><span>c</span><span>d</span><span>e</span><span>f</span><span>g</span><span>h</span>
              </div>
              <div class="board-coords board-coords-ranks">
                <span>8</span><span>7</span><span>6</span><span>5</span><span>4</span><span>3</span><span>2</span><span>1</span>
              </div>
              <div class="chessboard" id="chessboard"></div>
            </div>
            <div class="player-bar player-bar-bottom" id="player-bottom">
              <div class="player-avatar">♔</div>
              <div class="player-info">
                <span class="player-name">White</span>
                <span class="player-status">Waiting…</span>
              </div>
            </div>
          </section>

          <!-- Right Sidebar — Chat + Controls -->
          <aside class="sidebar sidebar-right">
            <div class="panel glass-panel chat-panel" id="chat-panel">
              <div class="chat-header">
                <h3 class="panel-title">💬 Chat</h3>
                <span class="chat-online-dot"></span>
              </div>
              <div class="chat-messages" id="chat-messages">
                <div class="chat-placeholder" id="chat-placeholder">
                  <span class="chat-placeholder-icon">💬</span>
                  <span>No messages yet</span>
                  <span class="chat-placeholder-hint">Say hello to your opponent!</span>
                </div>
              </div>
              <div class="chat-typing" id="chat-typing" style="display:none;">
                <span class="typing-dots"><span></span><span></span><span></span></span>
                <span class="typing-text" id="typing-text">Opponent is typing…</span>
              </div>
              <div class="chat-quick-emojis">
                <button class="emoji-btn" data-emoji="👍">👍</button>
                <button class="emoji-btn" data-emoji="😂">😂</button>
                <button class="emoji-btn" data-emoji="🔥">🔥</button>
                <button class="emoji-btn" data-emoji="😮">😮</button>
                <button class="emoji-btn" data-emoji="👏">👏</button>
                <button class="emoji-btn" data-emoji="💪">💪</button>
              </div>
              <div class="chat-input-area">
                <input type="text" id="chat-input" class="chat-input" placeholder="Type a message…" maxlength="200" autocomplete="off" />
                <button id="btn-send-chat" class="btn btn-chat-send" title="Send">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
              </div>
            </div>
            <div class="panel glass-panel game-controls">
              <button class="btn btn-danger" id="btn-resign" title="Resign">
                <span>🏳️</span> Resign
              </button>
              <button class="btn btn-secondary" id="btn-leave-game" title="Leave Game">
                <span>←</span> Leave
              </button>
            </div>
          </aside>

          <button id="btn-chat-toggle" class="chat-toggle-btn" title="Open Chat">💬</button>
        </div>
      </main>

      <!-- Footer -->
      <footer id="site-footer">
        <p>Developed by Aniruddh Parmar</p>
      </footer>
    </div>

    <!-- ============================================================
         SCREEN 5: OFFLINE PvP GAME
         ============================================================ -->
    <div id="offline-game-screen" class="screen">
      <header id="offline-header">
        <div class="header-inner">
          <div class="logo">
            <span class="logo-icon">♔</span>
            <span class="logo-text">ChessPlay</span>
          </div>
          <nav class="header-nav" style="display: flex; align-items: center; gap: 8px;">
            <span class="room-code-badge offline-badge">⚡ Offline PvP</span>
            <button id="btn-offline-settings" class="btn btn-secondary btn-small" style="font-size: 14px; padding: 6px 10px; border-radius: 8px;" title="Settings">⚙️</button>
          </nav>
        </div>
      </header>

      <main id="offline-game-area">
        <div class="offline-game-container">
          <section class="offline-board-section">
            <!-- Black player bar (top) -->
            <div class="player-bar player-bar-top offline-player-bar" id="offline-player-top">
              <div class="player-avatar">♚</div>
              <div class="player-info">
                <span class="player-name">Black</span>
                <span class="player-status">Waiting…</span>
              </div>
              <div class="offline-timer" id="offline-timer-black" style="display:none;">
                <span class="offline-timer-value">--:--</span>
              </div>
            </div>

            <!-- Turn Indicator -->
            <div class="offline-turn-banner" id="offline-turn-banner">
              <span class="offline-turn-dot" id="offline-turn-dot"></span>
              <span class="offline-turn-text" id="offline-turn-text">White's Turn</span>
            </div>

            <!-- Game Status -->
            <div class="game-status-banner" id="offline-game-status" style="display:none;">
              <span class="status-text" id="offline-status-text"></span>
            </div>

            <!-- Board -->
            <div class="board-wrapper offline-board-wrapper">
              <div class="board-coords board-coords-files">
                <span>a</span><span>b</span><span>c</span><span>d</span><span>e</span><span>f</span><span>g</span><span>h</span>
              </div>
              <div class="board-coords board-coords-ranks">
                <span>8</span><span>7</span><span>6</span><span>5</span><span>4</span><span>3</span><span>2</span><span>1</span>
              </div>
              <div class="chessboard offline-chessboard" id="offline-chessboard"></div>
            </div>

            <!-- White player bar (bottom) -->
            <div class="player-bar player-bar-bottom offline-player-bar" id="offline-player-bottom">
              <div class="player-avatar">♔</div>
              <div class="player-info">
                <span class="player-name">White</span>
                <span class="player-status">Your turn</span>
              </div>
              <div class="offline-timer" id="offline-timer-white" style="display:none;">
                <span class="offline-timer-value">--:--</span>
              </div>
            </div>

            <!-- Captured Pieces -->
            <div class="offline-captured-row">
              <div class="offline-captured-group">
                <span class="offline-captured-label">Captured by White:</span>
                <span class="captured-pieces" id="offline-captured-by-white"></span>
              </div>
              <div class="offline-captured-group">
                <span class="offline-captured-label">Captured by Black:</span>
                <span class="captured-pieces" id="offline-captured-by-black"></span>
              </div>
            </div>

            <!-- Controls -->
            <div class="offline-controls">
              <button class="btn btn-accent" id="btn-offline-new-game"><span>↻</span> New Game</button>
              <button class="btn btn-danger" id="btn-offline-resign"><span>🏳️</span> Resign</button>
              <button class="btn btn-secondary" id="btn-offline-back-lobby"><span>←</span> Leave</button>
            </div>
          </section>
        </div>
      </main>

      <footer id="offline-footer">
        <p>Developed by Aniruddh Parmar</p>
      </footer>
    </div>

    <!-- ============================================================
         GAME OVER MODAL — Premium Victory Celebration
         ============================================================ -->
    <canvas id="confetti-canvas"></canvas>
    <div id="gameover-modal" class="modal-overlay" style="display:none;">
      <div class="modal glass-panel gameover-modal-content" id="gameover-panel">
        <div class="victory-glow" id="victory-glow"></div>
        <div class="modal-crown" id="modal-crown">
          <span class="modal-icon" id="modal-icon">🏆</span>
        </div>
        <h2 class="modal-title" id="modal-title">Game Over</h2>
        <p class="modal-message" id="modal-message">Checkmate!</p>
        <p class="modal-quote" id="modal-quote"></p>
        <div class="modal-game-stats" id="modal-game-stats">
          <div class="modal-stat">
            <span class="modal-stat-value" id="modal-stat-moves">0</span>
            <span class="modal-stat-label">Moves</span>
          </div>
          <div class="modal-stat">
            <span class="modal-stat-value" id="modal-stat-duration">0:00</span>
            <span class="modal-stat-label">Duration</span>
          </div>
        </div>
        <div class="modal-actions">
          <button id="btn-modal-lobby" class="btn btn-primary">← New Game</button>
        </div>
      </div>
    </div>

    <!-- LEAVE CONFIRMATION MODAL -->
    <div id="leave-confirm-modal" class="modal-overlay" style="display:none; z-index: 10005;">
      <div class="modal glass-panel confirm-modal-content">
        <h2 class="modal-title" style="margin-top: 0; font-size: 20px; color: var(--accent);">Leave Game?</h2>
        <p class="modal-message" style="margin: 16px 0; font-size: 14px; color: var(--text-secondary); line-height: 1.5;">Are you sure you want to leave this game? Your current match will be abandoned and recorded as a loss.</p>
        <div class="modal-actions" style="display: flex; gap: 12px; margin-top: 24px; width: 100%;">
          <button id="btn-leave-cancel" class="btn btn-secondary" style="flex: 1; padding: 12px 16px;">Cancel</button>
          <button id="btn-leave-confirm" class="btn btn-danger" style="flex: 1; padding: 12px 16px;">Yes, Leave</button>
        </div>
      </div>
    </div>

    <!-- NEW GAME REQUEST MODAL -->
    <div id="newgame-request-modal" class="modal-overlay" style="display:none; z-index: 10006;">
      <div class="modal glass-panel newgame-modal-content">
        <h2 class="modal-title" style="margin-top: 0; font-size: 20px; color: var(--accent);">New Game Request</h2>
        <p class="modal-message" id="newgame-request-message" style="margin: 16px 0; font-size: 14px; color: var(--text-secondary); line-height: 1.5;">Your opponent wants to start a new game.</p>
        <div class="modal-actions" style="display: flex; gap: 12px; margin-top: 24px; width: 100%;">
          <button id="btn-newgame-decline" class="btn btn-secondary" style="flex: 1; padding: 12px 16px;">Decline</button>
          <button id="btn-newgame-accept" class="btn btn-primary" style="flex: 1; padding: 12px 16px;">Accept</button>
        </div>
      </div>
    </div>

    <!-- ============================================================
         MOBILE CHAT OVERLAY (shown on smaller screens)
         ============================================================ -->
    <div id="chat-overlay" class="chat-overlay">
      <div class="chat-panel-mobile">
        <div class="chat-overlay-header">
          <h3 class="panel-title">💬 Chat</h3>
          <button id="btn-close-chat" class="btn-close-chat" title="Close Chat">✕</button>
        </div>
        <div class="chat-messages" id="chat-messages-mobile"></div>
        <div class="chat-typing" id="chat-typing-mobile" style="display:none;">
          <span class="typing-dots"><span></span><span></span><span></span></span>
          <span class="typing-text">Opponent is typing…</span>
        </div>
        <div class="chat-quick-emojis">
          <button class="emoji-btn emoji-btn-mobile" data-emoji="👍">👍</button>
          <button class="emoji-btn emoji-btn-mobile" data-emoji="😂">😂</button>
          <button class="emoji-btn emoji-btn-mobile" data-emoji="🔥">🔥</button>
          <button class="emoji-btn emoji-btn-mobile" data-emoji="😮">😮</button>
          <button class="emoji-btn emoji-btn-mobile" data-emoji="👏">👏</button>
          <button class="emoji-btn emoji-btn-mobile" data-emoji="💪">💪</button>
        </div>
        <div class="chat-input-area">
          <input type="text" id="chat-input-mobile" class="chat-input" placeholder="Type a message…" maxlength="200" autocomplete="off" />
          <button id="btn-send-chat-mobile" class="btn btn-chat-send" title="Send">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================================
         PWA INSTALLATION POPUP (shown on mobile devices)
         ============================================================ -->
    <div id="pwa-install-popup" class="pwa-popup" style="display: none;">
      <div class="pwa-popup-content glass-panel">
        <div class="pwa-popup-icon">📱</div>
        <div class="pwa-popup-text">
          <h4 class="pwa-popup-title">Chess Play App</h4>
          <p class="pwa-popup-desc">Get faster performance and full-screen play!</p>
        </div>
        <div class="pwa-popup-actions">
          <button id="btn-pwa-install" class="btn btn-primary btn-small">Install</button>
          <button id="btn-pwa-dismiss" class="btn btn-secondary btn-small">Not Now</button>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script type="module" src="/js/chessgame.js?v=<%= Date.now() %>"></script>

  </body>
</html>
